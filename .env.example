# Safe local defaults. Copy to .env and edit only when a feature is enabled.
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true

# Paths are resolved from the repository root.
JOBHUNT_DATA_DIR=./data
JOBHUNT_DATABASE_PATH=./data/job_hunt.sqlite3
DEDUP_COMPANY_ALIASES_PATH=./config/company_aliases.json
FIT_RULES_PATH=./config/fit_rules.json
SQLITE_BUSY_TIMEOUT_MS=5000

# Approved ranking/filter policy.
STRICT_GERMAN_EXCLUSION=false
LANGUAGE_RISK_PENALTY=15
BANKING_PREFERENCE_BONUS=10

# Arbeitsagentur source adapter. The API key is the public web-client key.
ARBEITSAGENTUR_SEARCH_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/pc/v6/jobs
ARBEITSAGENTUR_DETAIL_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/pc/v4/jobdetails
ARBEITSAGENTUR_API_KEY=jobboerse-jobsuche
ARBEITSAGENTUR_LOCATION=Deutschland
ARBEITSAGENTUR_PUBLISHED_WITHIN_DAYS=7
ARBEITSAGENTUR_PAGE_SIZE=25
ARBEITSAGENTUR_MAX_PAGES=5
ARBEITSAGENTUR_CONNECT_TIMEOUT_SECONDS=5
ARBEITSAGENTUR_READ_TIMEOUT_SECONDS=20
ARBEITSAGENTUR_MAX_RETRIES=3
ARBEITSAGENTUR_BACKOFF_SECONDS=0.5
# Optional comma-separated override. Defaults are defined in typed configuration.
ARBEITSAGENTUR_QUERIES=

# EnglishJobs.de source adapter.
ENGLISHJOBS_BASE_URL=https://englishjobs.de
ENGLISHJOBS_PAGE_SIZE=20
ENGLISHJOBS_MAX_PAGES=5
ENGLISHJOBS_CONNECT_TIMEOUT_SECONDS=5
ENGLISHJOBS_READ_TIMEOUT_SECONDS=20
ENGLISHJOBS_MAX_RETRIES=3
ENGLISHJOBS_BACKOFF_SECONDS=0.5
ENGLISHJOBS_REQUEST_DELAY_SECONDS=1.0
# Optional comma-separated state keys. Defaults are defined in typed configuration.
ENGLISHJOBS_STATES=

# Future integrations remain disabled.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TOP_N=20
TELEGRAM_MIN_RANK_SCORE=0
TELEGRAM_MESSAGE_MAX_CHARS=4000
TELEGRAM_CONNECT_TIMEOUT_SECONDS=5
TELEGRAM_READ_TIMEOUT_SECONDS=20
TELEGRAM_MAX_RETRIES=3
TELEGRAM_BACKOFF_SECONDS=0.5

AI_PROVIDER=rule_based
AI_OLLAMA_API_KEY=
AI_LOCAL_MODEL=llama3.2:3b
AI_CLOUD_MODEL=gpt-oss:20b
AI_TIMEOUT_SECONDS=120
CV_ARTIFACT_ROOT=data/cv_artifacts
CV_MANUAL_MAX_BYTES=1000000

# Optional legacy MySQL import boundary. Disabled by default and not required for tests.
LEGACY_MYSQL_ENABLED=false
LEGACY_MYSQL_HOST=
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_DATABASE=
LEGACY_MYSQL_USER=
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_CONNECT_TIMEOUT_SECONDS=5
